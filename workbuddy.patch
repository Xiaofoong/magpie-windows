+package plugin
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestWorkBuddyImportPreservesUnreadableAuth(t *testing.T) {
+	sandbox(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	if err := os.MkdirAll(filepath.Dir(AuthPath()), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	broken := []byte(`{"saved-account":`)
+	if err := os.WriteFile(AuthPath(), broken, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	auth := map[string]any{
+		"type": "oauth", "uid": "new-fixture", "accountId": "new-fixture",
+		"access": "fixture-access", "expires": time.Now().Add(time.Hour).UnixMilli(),
+	}
+	if saved, err := ImportNewUID(ctx, "workbuddy", auth); err == nil || saved {
+		t.Fatal("an import replaced unreadable saved accounts")
+	}
+	after, err := os.ReadFile(AuthPath())
+	if err != nil || !bytes.Equal(after, broken) {
+		t.Fatalf("unreadable saved accounts changed: %v", err)
+	}
+}
+
+func TestImportNewUIDKeepsExistingSignIn(t *testing.T) {
+	sandbox(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	auth := func(uid, access string) map[string]any {
+		return map[string]any{
+			"type": "oauth", "uid": uid, "accountId": uid, "access": access,
+			"expires": time.Now().Add(time.Hour).UnixMilli(),
+		}
+	}
+	original := auth("existing", "fixture-existing")
+	original["refresh"] = "fixture-refresh"
+	if _, err := Import(ctx, "workbuddy", original); err != nil {
+		t.Fatal(err)
+	}
+	saved, err := ImportNewUID(ctx, "workbuddy", auth("existing", "fixture-replacement"))
+	if err != nil || saved {
+		t.Fatalf("same UID replaced an existing sign-in: saved=%v err=%v", saved, err)
+	}
+	var concurrent sync.WaitGroup
+	results := make(chan bool, 2)
+	for range 2 {
+		concurrent.Go(func() {
+			saved, err := ImportNewUID(ctx, "workbuddy", auth("new", "fixture-new"))
+			if err != nil {
+				t.Errorf("concurrent import: %v", err)
+			}
+			results <- saved
+		})
+	}
+	concurrent.Wait()
+	if <-results == <-results {
+		t.Fatal("concurrent import must save exactly one account")
+	}
+	all := Auths("workbuddy")
+	if len(all) != 2 || all["workbuddy"]["access"] != "fixture-existing" || all["workbuddy"]["refresh"] != "fixture-refresh" {
+		t.Fatal("unexpected accounts after concurrent import")
+	}
+}
+
+func TestWorkBuddySavedAccountsSurviveHostRestart(t *testing.T) {
+	sandbox(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	normal := map[string]any{
+		"type": "oauth", "uid": "normal-fixture", "accountId": "normal-fixture",
+		"access": "normal-access-fixture", "refresh": "normal-refresh-fixture",
+		"expires": time.Now().Add(time.Hour).UnixMilli(),
+	}
+	imported := map[string]any{
+		"type": "oauth", "uid": "imported-fixture", "accountId": "imported-fixture",
+		"access": "imported-access-fixture", "expires": time.Now().Add(time.Hour).UnixMilli(),
+	}
+	if _, err := Import(ctx, "workbuddy", normal); err != nil {
+		t.Fatal(err)
+	}
+	if saved, err := ImportNewUID(ctx, "workbuddy", imported); err != nil || !saved {
+		t.Fatalf("save failed: saved=%v err=%v", saved, err)
+	}
+	before, err := os.ReadFile(AuthPath())
+	if err != nil || len(before) == 0 {
+		t.Fatalf("accounts missing on disk: %v", err)
+	}
+	Restart()
+	all := Auths("workbuddy")
+	if len(all) != 2 {
+		t.Fatalf("after restart got %d accounts", len(all))
+	}
+	// Import starts a new host. Its duplicate check reads the saved UID.
+	if saved, err := ImportNewUID(ctx, "workbuddy", imported); err != nil || saved {
+		t.Fatalf("restarted host did not retain imported UID: saved=%v err=%v", saved, err)
+	}
+	foundRefresh := false
+	for _, auth := range all {
+		if auth["uid"] == "normal-fixture" {
+			foundRefresh = auth["refresh"] == "normal-refresh-fixture"
+		}
+	}
+	if !foundRefresh {
+		t.Fatal("saved login refresh credential missing after restart")
+	}
+}
