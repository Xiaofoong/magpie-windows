+const cnFixture = `{"provider":"codebuddy","uid":"cn-user","nickname":"Fixture CN","secret":{"accessToken":"fixture-access-cn","refreshToken":"fixture-refresh-cn","expiresAt":1800000000,"domain":"copilot.tencent.com","uid":"cn-user"}}`
