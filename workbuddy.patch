+}
+func TestImportPreviewIsReadOnlyCommitKeepsDuplicates(t *testing.T) {
+	all := importHarness(t)
+	data := currentFixture("[" + cnFixture + "," + aiFixture + "," + cnFixture + "]")
+	preview := callImport(t, data, false)
+	if len(all) != 0 || strings.Contains(preview, "fixture-access") || strings.Contains(preview, "fixture-refresh") || strings.Count(preview, `"status":"ready"`) != 2 || !strings.Contains(preview, `"status":"duplicate"`) {
+		t.Fatal("preview wrote, leaked or miscounted accounts")
+	}
+	committed := callImport(t, data, true)
+	if len(all) != 2 || strings.Count(committed, `"status":"imported"`) != 2 {
+		t.Fatal("did not import both sites")
+	}
+	old := all["workbuddy#cn-user"]["access"]
+	again := callImport(t, strings.ReplaceAll(data, "fixture-access-cn", "new-fixture-access"), true)
+	if len(all) != 2 || all["workbuddy#cn-user"]["access"] != old || strings.Count(again, `"status":"duplicate"`) != 3 {
+		t.Fatal("repeat replaced an existing credential")
+	}
+}
+func TestImportPartialFailureDoesNotLeakOrLoseOthers(t *testing.T) {
+	all := importHarness(t)
+	save := saveImport
+	saveImport = func(ctx context.Context, id string, a map[string]any) (bool, error) {
+		if id == "workbuddy-ai" {
+			return false, errors.New("fixture-refresh-sensitive")
+		}
+		return save(ctx, id, a)
+	}
+	response := callImport(t, currentFixture("["+cnFixture+","+aiFixture+"]"), true)
+	if len(all) != 1 || !strings.Contains(response, `"status":"failed"`) || strings.Contains(response, "sensitive") {
+		t.Fatal("partial failure leaked or lost successful account")
+	}
+	readImport = func() (map[string]map[string]any, error) {
+		return nil, errors.New("Saved account data is invalid. Import stopped.")
+	}
+	response = callImport(t, cnFixture, true)
+	if len(all) != 1 || !strings.Contains(response, `"error"`) {
+		t.Fatal("corrupt storage did not stop import")
+	}
+}
+
+func TestWorkBuddyImportRejectsUnusableExpiryAndNeverCopiesRefresh(t *testing.T) {
+	all := importHarness(t)
+	adoptions := 0
+	adoptImport = func(context.Context, string) error {
+		adoptions++
+		return nil
+	}
+	expired := strings.Replace(cnFixture, `"expiresAt":1800000000`, `"expiresAt":1700000000`, 1)
+	unknown := strings.Replace(aiFixture, `"expiresAt":1800000000`, `"expiresIn":3600`, 1)
+	for _, commit := range []bool{false, true} {
+		result := callImport(t, "["+expired+","+unknown+"]", commit)
+		if len(all) != 0 || adoptions != 0 || strings.Count(result, `"status":"reauth"`) != 2 {
+			t.Fatal("unusable snapshot was allowed to activate")
+		}
+	}
+	result := callImport(t, currentFixture(cnFixture), true)
+	a := all["workbuddy#cn-user"]
+	if !strings.Contains(result, `"status":"imported"`) || a["access"] != "fixture-access-cn" ||
+		a["refresh"] != nil || a["refreshExpiresAt"] != nil {
+		t.Fatal("valid import lost access or copied a refresh token")
+	}
+}
+
+func TestWorkBuddyImportIsDesktopOnly(t *testing.T) {
+	body := strings.NewReader(`{"commit":false,"data":"[]"}`)
+	w := httptest.NewRecorder()
+	Handler(webHost{}, nil).ServeHTTP(w, httptest.NewRequest("POST", "/api/workbuddy/import", body))
+	if strings.Contains(w.Body.String(), "Select a file with 1 to 200 accounts.") || w.Code == 200 {
