diff --git a/internal/gui/assets/workbuddy-export.js b/internal/gui/assets/workbuddy-export.js
new file mode 100644
index 0000000000000000000000000000000000000000..6118a61b303dea90f9b9b041fd7304da0a8e0a24
--- /dev/null
+++ b/internal/gui/assets/workbuddy-export.js
@@ -0,0 +1,95 @@
+(() => {
+  const entry = $("#workbuddyExport");
+  if (!entry || !window.bootPrefs?.workbuddyImport || mode !== "window") return;
+  entry.onclick = async () => {
+    const dialog = el("dialog", "action-confirm workbuddy-import");
+    const title = el("h2", "", t("Export WorkBuddy accounts"));
+    title.id = "workbuddyExportTitle";
+    dialog.setAttribute("aria-labelledby", title.id);
+    const instructions = el("p", "", t("Select the accounts to export, then choose where to save the JSON."));
+    const warning = el("p", "", t("Keep this JSON private. It contains the selected accounts’ sign-in credentials."));
+    const status = el("p", "import-status", t("Reading accounts…"));
+    status.setAttribute("role", "status");
+    const list = el("ul");
+    list.hidden = true;
+    const all = el("button", "text", t("Select all accounts"));
+    const close = el("button", "text", t("Close"));
+    const save = el("button", "text primary", t("Choose folder and export"));
+    all.disabled = save.disabled = true;
+    const bar = el("div", "bar");
+    bar.append(all, el("span", "grow"), close, save);
+    dialog.append(title, instructions, warning, list, bar, status);
+
+    let saving = false;
+    const choices = [];
+    const selected = () => choices.filter(({ input }) => input.checked);
+    function sync() {
+      const count = selected().length;
+      all.disabled = saving || !choices.length;
+      save.disabled = saving || count === 0 || count > 200;
+      all.textContent = t(count === choices.length && count > 0 ? "Clear selection" : "Select all accounts");
+      for (const { input } of choices) input.disabled = saving;
+    }
+
+    all.onclick = () => {
+      const check = selected().length !== choices.length;
+      for (const { input } of choices) input.checked = check;
+      status.textContent = check && choices.length > 200 ? t("Select 1 to 200 exportable accounts.") : "";
+      sync();
+    };
+    save.onclick = async () => {
+      const keys = selected().map(({ key }) => key);
+      if (save.disabled) return;
+      saving = close.disabled = true;
+      sync();
+      status.textContent = t("Saving accounts…");
+      try {
+        const result = await api("workbuddy/export", { keys, language: locale });
+        status.textContent = result.canceled ? "" : t("Export saved to {path}", { path: result.path });
+      } catch (error) {
+        status.textContent = t(error.message);
+      } finally {
+        saving = close.disabled = false;
+        sync();
+        close.focus(NO_SCROLL);
+      }
+    };
+    close.onclick = () => dialog.close();
+    dialog.addEventListener("cancel", (event) => { if (saving) event.preventDefault(); });
+    dialog.addEventListener("keydown", (event) => event.stopPropagation());
+    dialog.addEventListener("close", () => {
+      dialog.remove();
+      entry.focus(NO_SCROLL);
+    });
+    document.body.append(dialog);
+    dialog.showModal();
+    close.focus(NO_SCROLL);
+
+    try {
+      const { accounts } = await api("workbuddy/export");
+      if (!dialog.open) return;
+      const masked = window.hideAccounts?.on();
+      for (const [index, row] of accounts.entries()) {
+        const input = el("input");
+        input.type = "checkbox";
+        input.disabled = !row.exportable;
+        input.onchange = () => {
+          status.textContent = selected().length > 200 ? t("Select 1 to 200 exportable accounts.") : "";
+          sync();
+        };
+        const name = masked ? t("Account {n}", { n: index + 1 }) : row.name;
+        const label = el("label");
+        label.append(input, el("b", "", name + " · " + t(row.site)));
+        const item = el("li", "", label);
+        item.append(el("span", "", t(row.detail)));
+        list.append(item);
+        if (row.exportable) choices.push({ input, key: row.key });
+      }
+      list.hidden = !accounts.length;
+      status.textContent = choices.length ? "" : t("No WorkBuddy accounts are available to export.");
+      sync();
+    } catch (error) {
+      if (dialog.open) status.textContent = t(error.message);
+    }
+  };
+})();
