diff --git a/internal/gui/assets/workbuddy-import.js b/internal/gui/assets/workbuddy-import.js
new file mode 100644
index 0000000000000000000000000000000000000000..b577865c6eb23a7a4b3bc547cd07c7403d9bf638
--- /dev/null
+++ b/internal/gui/assets/workbuddy-import.js
@@ -0,0 +1,131 @@
+(() => {
+  const entry = $("#workbuddyImport");
+  if (!entry || !window.bootPrefs?.workbuddyImport || mode !== "window") return;
+  $("#workbuddyActions").hidden = false;
+  entry.onclick = () => {
+    const dialog = el("dialog", "action-confirm workbuddy-import");
+    const title = el("h2", "", t("Import WorkBuddy accounts"));
+    title.id = "workbuddyImportTitle";
+    dialog.setAttribute("aria-labelledby", title.id);
+    const description = el("p", "", t("Choose a WorkBuddy or CodeBuddy JSON export to preview its accounts."));
+    const renew = el("input");
+    renew.type = "checkbox";
+    renew.checked = true;
+    renew.id = "workbuddyImportRenew";
+    const renewalChoice = el("label", "");
+    renewalChoice.append(renew, " ", t("Transfer to this computer and renew automatically"));
+    const renewalNote = el("p", "", t("Requires a refresh credential in the file. Transferring rotates the sign-in; the original device may need to sign in again. Without this option, only the current access authorization is imported."));
+    const status = el("p", "import-status");
+    status.setAttribute("role", "status");
+    const accounts = el("ul");
+    accounts.hidden = true;
+    const input = el("input");
+    input.type = "file";
+    input.accept = ".json,application/json";
+    input.hidden = true;
+    const choose = el("button", "text", t("Choose JSON file"));
+    const close = el("button", "text", t("Close"));
+    const confirm = el("button", "text primary", t("Import selected file"));
+    confirm.disabled = true;
+    const bar = el("div", "bar");
+    bar.append(choose, el("span", "grow"), close, confirm);
+    dialog.append(title, description, renewalChoice, renewalNote, input, bar, status, accounts);
+
+    let data = "", selected = "", saving = false, selection = 0;
+    function showRows(rows) {
+      const masked = window.hideAccounts?.on();
+      accounts.replaceChildren(...rows.map((row) => {
+        const name = masked || row.status === "invalid" ? t("Account {n}", { n: row.index + 1 }) : row.name;
+        const item = el("li", "", el("b", "", [name, row.site && t(row.site)].filter(Boolean).join(" · ")));
+        item.append(el("span", "", t(row.detail)));
+        return item;
+      }));
+      accounts.hidden = rows.length === 0;
+    }
+
+    choose.onclick = () => input.click();
+    async function preview(contents, current) {
+      data = "";
+      confirm.disabled = renew.disabled = true;
+      showRows([]);
+      status.textContent = t("Reading file…");
+      try {
+        const result = await api("workbuddy/import", { data: contents, commit: false, renew: renew.checked });
+        if (selection !== current) return;
+        showRows(result.accounts);
+        status.textContent = "";
+        if (result.accounts.some((row) => row.status === "ready")) {
+          data = contents;
+          confirm.disabled = false;
+        }
+      } catch (error) {
+        if (selection === current) status.textContent = t(error.message);
+      } finally {
+        if (selection === current) renew.disabled = false;
+      }
+    }
+    renew.onchange = async () => {
+      if (selected && !saving) await preview(selected, ++selection);
+    };
+    input.onchange = async () => {
+      const file = input.files[0];
+      input.value = "";
+      if (!file) return;
+      const current = ++selection;
+      data = selected = "";
+      confirm.disabled = true;
+      renew.disabled = false;
+      showRows([]);
+      if (file.size > 1 << 20) {
+        status.textContent = t("The file exceeds 1 MB.");
+        return;
+      }
+      status.textContent = t("Reading file…");
+      renew.disabled = true;
+      let contents;
+      try {
+        contents = await file.text();
+      } catch {
+        if (selection === current) {
+          status.textContent = t("Could not read the selected file.");
+          renew.disabled = false;
+        }
+        return;
+      }
+      if (selection !== current) return;
+      selected = contents;
+      await preview(contents, current);
+    };
+
+    confirm.onclick = async () => {
+      if (!data || saving) return;
+      saving = choose.disabled = close.disabled = confirm.disabled = renew.disabled = true;
+      status.textContent = t("Importing accounts…");
+      try {
+        const result = await api("workbuddy/import", { data, commit: true, renew: renew.checked });
+        showRows(result.accounts);
+        status.textContent = "";
+        if (!result.accounts.some((row) => row.status === "failed")) data = "";
+        if (result.accounts.some((row) => row.status === "imported")) loadProviders().catch(() => {});
+      } catch (error) {
+        status.textContent = t(error.message);
+      } finally {
+        saving = choose.disabled = close.disabled = renew.disabled = false;
+        confirm.disabled = !data;
+        close.focus(NO_SCROLL);
+      }
+    };
+    close.onclick = () => dialog.close();
+    dialog.addEventListener("cancel", (event) => { if (saving) event.preventDefault(); });
+    dialog.addEventListener("keydown", (event) => event.stopPropagation());
+    dialog.addEventListener("close", () => {
+      selection++;
+      data = selected = "";
+      dialog.remove();
+      entry.focus(NO_SCROLL);
+    });
+    document.body.append(dialog);
+    dialog.showModal();
+    choose.focus(NO_SCROLL);
+  };
+})();
diff --git a/internal/gui/tests/workbuddy-import.test.cjs b/internal/gui/tests/workbuddy-import.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..7eef44fb9ecb4291de752d72f325d4fb877db1f2
--- /dev/null
+++ b/internal/gui/tests/workbuddy-import.test.cjs
@@ -0,0 +1,53 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { test } = require("node:test");
+const { chromium } = require("playwright");
+
+const assets = process.env.MAGPIE_ASSETS || path.resolve(__dirname, "../assets");
+const file = JSON.stringify({ uid: "fixture-1", accessToken: "fixture-token", edition: "cn", expiresAt: 1800000000 });
+
+test("WorkBuddy file preview and confirmation on the desktop Providers page", async (t) => {
+  const browser = await chromium.launch(process.env.CHROMIUM_EXE ? { executablePath: process.env.CHROMIUM_EXE } : { channel: "chromium" });
+  t.after(() => browser.close());
+  const page = await browser.newPage({ viewport: { width: 480, height: 700 } });
+  page.setDefaultTimeout(6000);
+  const posts = [];
+  await page.route("**/*", async (route) => {
+    const url = new URL(route.request().url());
+    const json = (data) => route.fulfill({ json: data });
+    if (url.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: 'window.bootPrefs = {lang:"zh",theme:"light",workbuddyImport:true};' });
+    if (url.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
+    if (url.pathname === "/api/state") return json({ agents: [], profiles: [], settings: { lang: "zh" } });
+    if (url.pathname === "/api/providers") return json({ providers: [], presets: [], excluded: [], gateway: {}, plugins: [] });
+    if (url.pathname === "/api/workbuddy/import") {
+      const { data, commit } = route.request().postDataJSON();
+      posts.push({ data, commit });
+      const detail = commit ? "Imported. Sign in again from Providers when authorization expires." : "Ready to import. Sign in again when authorization expires.";
+      return json({ accounts: [{ name: "Fixture account", site: "WorkBuddy (China)", index: 0, status: commit ? "imported" : "ready", detail }] });
+    }
+    if (url.pathname.startsWith("/api/")) return json({});
+    const filename = path.join(assets, url.pathname === "/" ? "index.html" : url.pathname);
+    const contentType = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml" }[path.extname(filename)];
+    try { await route.fulfill({ body: await fs.readFile(filename), contentType }); } catch { await route.fulfill({ status: 404 }); }
+  });
+  await page.goto("http://magpie.test/?view=providers");
+  const entry = page.getByRole("button", { name: "导入 WorkBuddy 账号" });
+  await entry.click();
+  const dialog = page.getByRole("dialog");
+  const upload = () => dialog.locator('input[type="file"]').setInputFiles({ name: "fixture.json", mimeType: "application/json", buffer: Buffer.from(file) });
+  await upload();
+  await dialog.getByText("Fixture account", { exact: false }).waitFor();
+  assert.deepEqual(posts, [{ data: file, commit: false }]);
+  assert.doesNotMatch(await dialog.textContent(), /fixture-token/);
+  await page.keyboard.press("Escape");
+  await dialog.waitFor({ state: "detached" });
+  assert.equal(posts.length, 1);
+
+  await entry.click();
+  await upload();
+  await dialog.getByRole("button", { name: "确认导入" }).click();
+  await dialog.getByText("已导入当前授权，到期或失效后请在供应商页面重新登录").waitFor();
+  assert.deepEqual(posts, [{ data: file, commit: false }, { data: file, commit: false }, { data: file, commit: true }]);
+  assert.equal(await dialog.getByRole("button", { name: "确认导入" }).isDisabled(), true);
+});
diff --git a/internal/gui/workbuddy_export.go b/internal/gui/workbuddy_export.go
new file mode 100644
index 0000000000000000000000000000000000000000..849ea0186af797a94e00973ca63f28ca0e8ef6ba
--- /dev/null
+++ b/internal/gui/workbuddy_export.go
@@ -0,0 +1,196 @@
+package gui
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/yetone/magpie/internal/provider"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+type exportPreview struct {
+	Key        string `json:"key"`
+	Name       string `json:"name"`
+	Site       string `json:"site"`
+	Exportable bool   `json:"exportable"`
+	Detail     string `json:"detail"`
+}
+
+func exportString(v any) string { s, _ := v.(string); return s }
+func exportMillis(v any) int64 {
+	switch n := v.(type) {
+	case float64:
+		if n > 0 && n <= 32503680000000 {
+			return int64(n)
+		}
+	case int64:
+		return n
+	case int:
+		return int64(n)
+	case json.Number:
+		x, _ := n.Int64()
+		return x
+	case string:
+		x, _ := strconv.ParseInt(n, 10, 64)
+		return x
+	}
+	return 0
+}
+func exportName(a map[string]any) string {
+	if name := exportString(a["nickname"]); name != "" {
+		return name
+	}
+	name := exportString(a["accountId"])
+	uid := exportString(a["uid"])
+	enterprise := exportString(a["enterpriseId"])
+	suffix := " · " + uid
+	if enterprise != "" {
+		suffix += " · " + enterprise
+	}
+	if uid != "" {
+		name = strings.TrimSuffix(name, suffix)
+	}
+	return firstImport(name, uid, "WorkBuddy account")
+}
+func workbuddyExports(all map[string]map[string]any) []exportPreview {
+	rows := []exportPreview{}
+	keys := make([]string, 0, len(all))
+	for key := range all {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		site := plugin.ProviderOf(key)
+		if site != "workbuddy" && site != "workbuddy-ai" {
+			continue
+		}
+		a := all[key]
+		ok := a["type"] == "oauth" && exportString(a["source"]) == "" && exportString(a["uid"]) != "" && exportString(a["access"]) != ""
+		detail := "Available to export"
+		if !ok {
+			detail = "API keys and linked desktop sign-ins cannot be exported as accounts."
+		}
+		rows = append(rows, exportPreview{key, exportName(a), map[string]string{"workbuddy": "WorkBuddy (China)", "workbuddy-ai": "WorkBuddy AI (International)"}[site], ok, detail})
+	}
+	return rows
+}
+
+// Selection is a fresh, read-only snapshot; unlike plugin.Take it never signs
+// out accounts or rotates tokens. The explicit export response alone has secrets.
+func workbuddyExportData(all map[string]map[string]any, keys []string) (string, error) {
+	if len(keys) == 0 || len(keys) > 200 {
+		return "", errors.New("Select 1 to 200 exportable accounts.")
+	}
+	available := map[string]bool{}
+	for _, row := range workbuddyExports(all) {
+		available[row.Key] = row.Exportable
+	}
+	selected := map[string]bool{}
+	rows := make([]map[string]any, 0, len(keys))
+	for _, key := range keys {
+		if selected[key] {
+			continue
+		}
+		selected[key] = true
+		if !available[key] {
+			return "", errors.New("The selected account changed or cannot be exported. Reopen the export list.")
+		}
+		a := all[key]
+		site := plugin.ProviderOf(key)
+		edition := "cn"
+		if site == "workbuddy-ai" {
+			edition = "intl"
+		}
+		row := map[string]any{"provider": site, "edition": edition, "uid": exportString(a["uid"]), "nickname": exportName(a), "accessToken": exportString(a["access"]), "expiresAt": exportMillis(a["expires"]), "domain": exportString(a["domain"])}
+		if refresh := exportString(a["refresh"]); refresh != "" {
+			row["refreshToken"] = refresh
+		}
+		if e := exportString(a["enterpriseId"]); e != "" {
+			row["enterpriseId"] = e
+		}
+		if n := exportMillis(a["refreshExpiresAt"]); n > 0 {
+			row["refreshExpiresAt"] = n
+		}
+		if t := exportString(a["tokenType"]); t != "" {
+			row["tokenType"] = t
+		}
+		// Validate the file we offer against our importer before exposing it.
+		b, _ := json.Marshal(row)
+		var check importFileRow
+		if json.Unmarshal(b, &check) != nil {
+			return "", errors.New("The account data is incomplete and cannot be exported.")
+		}
+		if _, err := normalizeImport(check); err != nil {
+			return "", errors.New("The account data is incomplete and cannot be exported.")
+		}
+		rows = append(rows, row)
+	}
+	b, err := json.MarshalIndent(rows, "", "  ")
+	if err != nil || len(b)+1 > 1<<20 {
+		return "", errors.New("The export is too large. Select fewer accounts.")
+	}
+	return string(b) + "\n", nil
+}
+func workBuddyExportRoutes(mux *http.ServeMux, w Windows) {
+	mux.HandleFunc("GET /api/workbuddy/export", func(rw http.ResponseWriter, r *http.Request) {
+		rw.Header().Set("Cache-Control", "no-store")
+		all, err := readImport()
+		if err != nil {
+			fail(rw, err)
+			return
+		}
+		writeJSON(rw, map[string]any{"accounts": workbuddyExports(all)})
+	})
+	mux.HandleFunc("POST /api/workbuddy/export", func(rw http.ResponseWriter, r *http.Request) {
+		rw.Header().Set("Cache-Control", "no-store")
+		if w == nil {
+			fail(rw, errors.New("Open the desktop app to export accounts."))
+			return
+		}
+		var in struct {
+			Keys     []string `json:"keys"`
+			Language string   `json:"language"`
+		}
+		if err := json.NewDecoder(http.MaxBytesReader(rw, r.Body, 65536)).Decode(&in); err != nil || len(in.Keys) == 0 || len(in.Keys) > 200 {
+			fail(rw, errors.New("Select 1 to 200 exportable accounts."))
+			return
+		}
+		title := "Choose a folder for the WorkBuddy export"
+		if in.Language == "zh" {
+			title = "选择 WorkBuddy 账号导出的保存位置"
+		}
+		dir, err := w.ChooseFolder(title)
+		if err != nil {
+			fail(rw, errors.New("Could not open the folder picker."))
+			return
+		}
+		if dir == "" {
+			writeJSON(rw, map[string]bool{"canceled": true})
+			return
+		}
+		// Read again after the dialog. A sign-in may have changed while it was open.
+		all, err := readImport()
+		if err != nil {
+			fail(rw, err)
+			return
+		}
+		data, err := workbuddyExportData(all, in.Keys)
+		if err != nil {
+			fail(rw, err)
+			return
+		}
+		paths, err := provider.WriteExport(provider.ExportResult{
+			Files: []provider.ExportFile{{Name: "workbuddy-accounts.json", Data: []byte(data)}},
+		}, dir)
+		if err != nil {
+			fail(rw, errors.New("Could not write the export in the selected folder."))
+			return
+		}
+		writeJSON(rw, map[string]string{"path": paths[0]})
+	})
+}
diff --git a/internal/gui/workbuddy_export_test.go b/internal/gui/workbuddy_export_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..05844d91edbbbc3e07eb4496c6d6f88227167d14
--- /dev/null
+++ b/internal/gui/workbuddy_export_test.go
@@ -0,0 +1,75 @@
+package gui
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestWorkBuddyExportWritesOnlySelectedAccounts(t *testing.T) {
+	all := importHarness(t)
+	for _, text := range []string{cnFixture, aiFixture} {
+		rows, err := parseImport(currentFixture(text))
+		if err != nil {
+			t.Fatal(err)
+		}
+		a, err := normalizeImport(rows[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		all[a.site+"#fixture"] = a.auth
+	}
+	all["workbuddy#fixture"]["refresh"] = "fixture-saved-refresh"
+	all["workbuddy#desktop"] = map[string]any{"source": "desktop", "type": "oauth", "access": "fixture-desktop-secret"}
+	all["other"] = map[string]any{"type": "oauth", "access": "fixture-other-secret"}
+	dir := t.TempDir()
+	request := func(host Windows, method, body string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		Handler(host, nil).ServeHTTP(w, httptest.NewRequest(method, "/api/workbuddy/export", strings.NewReader(body)))
+		return w
+	}
+	post := `{"keys":["workbuddy#fixture"]}`
+	preview := request(pickFolder{dir: dir}, http.MethodGet, "")
+	if preview.Code != 200 || strings.Contains(preview.Body.String(), "fixture-access") || strings.Contains(preview.Body.String(), "fixture-saved-refresh") || strings.Contains(preview.Body.String(), "fixture-other-secret") {
+		t.Fatal("export preview was unavailable or contained credentials")
+	}
+	cancel := request(pickFolder{}, http.MethodPost, post)
+	if cancel.Code != 200 || !strings.Contains(cancel.Body.String(), "canceled") {
+		t.Fatal("cancel did not stop export")
+	}
+	result := request(pickFolder{dir: dir}, http.MethodPost, post)
+	if result.Code != 200 || strings.Contains(result.Body.String(), "fixture-saved-refresh") {
+		t.Fatalf("export response: status %d", result.Code)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "workbuddy-accounts.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), "fixture-saved-refresh") || strings.Contains(string(data), "fixture-access-ai") {
+		t.Fatal("file did not contain exactly the selected sign-in")
+	}
+	rows, err := parseImport(string(data))
+	if err != nil || len(rows) != 1 {
+		t.Fatal("export cannot round trip through the mobile-compatible importer", err)
+	}
+	if a, err := normalizeImport(rows[0]); err != nil || a.uid != "cn-user" || a.auth["refresh"] != nil {
+		t.Fatal("import did not honor its access-token-only policy", err)
+	}
+	if repeat := request(pickFolder{dir: dir}, http.MethodPost, post); repeat.Code != 200 {
+		t.Fatal("repeat export failed")
+	}
+	if _, err := os.Stat(filepath.Join(dir, "workbuddy-accounts-2.json")); err != nil {
+		t.Fatal("repeat export overwrote the first file", err)
+	}
+	if len(all) != 4 || all["workbuddy#fixture"]["refresh"] != "fixture-saved-refresh" {
+		t.Fatal("export changed saved sign-ins")
+	}
+	for _, method := range []string{http.MethodGet, http.MethodPost} {
+		if got := request(webHost{}, method, post); got.Code == 200 && strings.Contains(got.Body.String(), "workbuddy#fixture") {
+			t.Fatal("a browser page could list or export sign-ins")
+		}
+	}
+}
diff --git a/internal/gui/workbuddy_import.go b/internal/gui/workbuddy_import.go
new file mode 100644
index 0000000000000000000000000000000000000000..e5e5666a9cca656e9310a614e4c833b8169cd820
--- /dev/null
+++ b/internal/gui/workbuddy_import.go
@@ -0,0 +1,468 @@
+package gui
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+const wbPackage = "@magpie-community/opencode-workbuddy-auth"
+
+type importSecret struct {
+	Access         string `json:"accessToken"`
+	Expires        int64  `json:"expiresAt"`
+	Refresh        string `json:"refreshToken"`
+	RefreshExpires int64  `json:"refreshExpiresAt"`
+	Domain         string `json:"domain"`
+	UID            string `json:"uid"`
+	Name           string `json:"nickname"`
+	Enterprise     string `json:"enterpriseId"`
+	TokenType      string `json:"tokenType"`
+}
+type importFileRow struct {
+	Provider string       `json:"provider"`
+	Region   string       `json:"region"`
+	Edition  string       `json:"edition"`
+	Label    string       `json:"label"`
+	UID      string       `json:"uid"`
+	Name     string       `json:"nickname"`
+	Secret   importSecret `json:"secret"`
+	Auth     importSecret `json:"auth"`
+	Flat     importSecret `json:"-"`
+	Account  struct {
+		UID        string `json:"uid"`
+		Name       string `json:"nickname"`
+		Enterprise string `json:"enterpriseId"`
+	} `json:"account"`
+}
+
+// A flat export and a nested export carry the same credential fields. Decode
+// explicitly into both shapes without making unrelated provider types valid.
+func (row *importFileRow) UnmarshalJSON(b []byte) error {
+	type plain importFileRow
+	var value plain
+	if err := json.Unmarshal(b, &value); err != nil {
+		return err
+	}
+	if err := json.Unmarshal(b, &value.Flat); err != nil {
+		return err
+	}
+	*row = importFileRow(value)
+	return nil
+}
+
+type importedAccount struct {
+	site, uid, name string
+	auth            map[string]any
+}
+type importPreview struct {
+	Index  int    `json:"index"`
+	Name   string `json:"name"`
+	Site   string `json:"site"`
+	Status string `json:"status"`
+	Detail string `json:"detail"`
+}
+
+func firstImport(values ...string) string {
+	for _, v := range values {
+		if strings.TrimSpace(v) != "" {
+			return strings.TrimSpace(v)
+		}
+	}
+	return ""
+}
+func importMillis(n int64) int64 {
+	if n > 0 && n < 100000000000 {
+		return n * 1000
+	}
+	return n
+}
+func importSite(providerID, region, domain string) (string, error) {
+	p := strings.ToLower(strings.TrimSpace(providerID))
+	r := strings.ToLower(strings.TrimSpace(region))
+	site := ""
+	switch p {
+	case "codebuddy", "workbuddy", "workbuddy-cn", "codebuddy-cn":
+		site = "workbuddy"
+	case "workbuddy-ai", "workbuddy-intl", "codebuddy-intl", "codebuddy-ai":
+		site = "workbuddy-ai"
+	case "":
+	default:
+		return "", errors.New("Unsupported WorkBuddy / CodeBuddy account format.")
+	}
+	regional := ""
+	switch r {
+	case "cn", "china", "domestic":
+		regional = "workbuddy"
+	case "international", "intl", "global", "ai", "overseas":
+		regional = "workbuddy-ai"
+	case "":
+	default:
+		return "", errors.New("Unknown account region.")
+	}
+	if p != "codebuddy" && site != "" && regional != "" && site != regional {
+		return "", errors.New("Account type and region do not match.")
+	}
+	if regional != "" {
+		site = regional
+	}
+	host := strings.ToLower(strings.TrimSpace(domain))
+	if strings.Contains(host, "://") {
+		u, e := url.Parse(host)
+		if e != nil || u.Scheme != "https" || u.User != nil || (u.Path != "" && u.Path != "/") || u.RawQuery != "" || u.Fragment != "" {
+			return "", errors.New("Invalid account domain.")
+		}
+		host = u.Host
+	}
+	ds := ""
+	switch host {
+	case "copilot.tencent.com", "www.codebuddy.cn", "codebuddy.cn":
+		ds = "workbuddy"
+	case "www.workbuddy.ai", "workbuddy.ai", "www.codebuddy.ai", "codebuddy.ai":
+		ds = "workbuddy-ai"
+	case "":
+	default:
+		return "", errors.New("Unsupported account domain.")
+	}
+	// codebuddy is an export's generic label; the official domain is decisive.
+	if ds != "" {
+		if regional != "" && regional != ds {
+			return "", errors.New("Account region and domain do not match.")
+		}
+		if p != "" && p != "codebuddy" && site != "" && site != ds {
+			return "", errors.New("Account type and domain do not match.")
+		}
+		site = ds
+	}
+	if site == "" {
+		return "", errors.New("The account needs a recognized region or domain.")
+	}
+	return site, nil
+}
+func parseImport(data string) ([]importFileRow, error) {
+	if len(data) > 1<<20 {
+		return nil, errors.New("The file exceeds 1 MB.")
+	}
+	data = strings.TrimPrefix(strings.TrimSpace(data), "\ufeff")
+	var raw json.RawMessage
+	if json.Unmarshal([]byte(data), &raw) != nil {
+		return nil, errors.New("Invalid JSON. Select the original export file.")
+	}
+	var rows []importFileRow
+	if len(raw) > 0 && raw[0] == '[' {
+		if json.Unmarshal(raw, &rows) != nil {
+			return nil, errors.New("An account field has an invalid type.")
+		}
+	} else {
+		var envelope map[string]json.RawMessage
+		if json.Unmarshal(raw, &envelope) != nil || envelope == nil {
+			return nil, errors.New("The file must contain an account object or an array.")
+		}
+		if accounts, ok := envelope["accounts"]; ok {
+			if json.Unmarshal(accounts, &rows) != nil {
+				return nil, errors.New("The accounts field must be an array.")
+			}
+		} else {
+			var row importFileRow
+			if json.Unmarshal(raw, &row) != nil {
+				return nil, errors.New("An account field has an invalid type.")
+			}
+			rows = []importFileRow{row}
+		}
+	}
+	if len(rows) == 0 || len(rows) > 200 {
+		return nil, errors.New("Select a file with 1 to 200 accounts.")
+	}
+	return rows, nil
+}
+func normalizeImport(row importFileRow) (importedAccount, error) {
+	s := importCredentials(row)
+	uid := firstImport(row.UID, s.UID, row.Account.UID)
+	for _, v := range []string{row.UID, s.UID, row.Account.UID} {
+		if v != "" && strings.TrimSpace(v) != uid {
+			return importedAccount{}, errors.New("Account UIDs do not match.")
+		}
+	}
+	if uid == "" || len(uid) > 256 || strings.ContainsAny(uid, "\r\n\x00") {
+		return importedAccount{}, errors.New("A valid account UID is required.")
+	}
+	if strings.TrimSpace(s.Access) == "" || len(s.Access) > 32768 || strings.ContainsAny(s.Access, "\r\n\x00") {
+		return importedAccount{}, errors.New("A valid access token is required.")
+	}
+	if row.Region != "" && row.Edition != "" {
+		a, e1 := importSite("", row.Region, "")
+		b, e2 := importSite("", row.Edition, "")
+		if e1 != nil || e2 != nil || a != b {
+			return importedAccount{}, errors.New("The region and edition do not match.")
+		}
+	}
+	site, err := importSite(row.Provider, firstImport(row.Region, row.Edition), s.Domain)
+	if err != nil {
+		return importedAccount{}, err
+	}
+	name := firstImport(row.Name, s.Name, row.Account.Name, row.Label, uid)
+	if len(name) > 300 {
+		name = uid
+	}
+	enterprise := firstImport(s.Enterprise, row.Account.Enterprise)
+	if len(enterprise) > 256 || strings.ContainsAny(enterprise, "\r\n\x00") {
+		return importedAccount{}, errors.New("Invalid enterprise ID.")
+	}
+	domain := strings.TrimSpace(s.Domain)
+	if strings.Contains(domain, "://") {
+		u, _ := url.Parse(domain)
+		domain = u.Host
+	}
+	expires := importMillis(s.Expires)
+	if expires < 0 || expires > 32503680000000 {
+		return importedAccount{}, errors.New("Invalid expiration time.")
+	}
+	// A relative lifetime without the time the token was issued is unknown.
+	accountID := name + " · " + uid
+	if enterprise != "" {
+		accountID += " · " + enterprise
+	}
+	// WorkBuddy spends a refresh token once. Copying it into another client
+	// can invalidate the session still in use by the original client.
+	auth := map[string]any{"type": "oauth", "access": s.Access, "expires": expires, "uid": uid, "accountId": accountID, "domain": domain}
+	auth["nickname"] = name
+	if enterprise != "" {
+		auth["enterpriseId"] = enterprise
+	}
+	if s.TokenType != "" && len(s.TokenType) < 100 {
+		auth["tokenType"] = s.TokenType
+	}
+	return importedAccount{site, uid, name, auth}, nil
+}
+
+func importCredentials(row importFileRow) importSecret {
+	if row.Secret.Access != "" {
+		return row.Secret
+	}
+	if row.Auth.Access != "" {
+		return row.Auth
+	}
+	return row.Flat
+}
+
+func renewalImport(row importFileRow, account importedAccount) (importedAccount, error) {
+	secret := importCredentials(row)
+	if strings.TrimSpace(secret.Refresh) == "" {
+		return account, errors.New("This file has no refresh credential. Sign in on this computer to enable automatic renewal.")
+	}
+	if len(secret.Refresh) > 32768 || strings.ContainsAny(secret.Refresh, "\r\n\x00") {
+		return account, errors.New("The refresh credential is invalid.")
+	}
+	expires := importMillis(secret.RefreshExpires)
+	if expires < 0 || expires > 32503680000000 {
+		return account, errors.New("Invalid refresh expiration time.")
+	}
+	if expires > 0 && expires <= time.Now().UnixMilli() {
+		return account, errors.New("The refresh credential has expired. Sign in on this computer again.")
+	}
+	account.auth["refresh"] = secret.Refresh
+	if expires > 0 {
+		account.auth["refreshExpiresAt"] = expires
+	}
+	return account, nil
+}
+func existingImports() (map[string]map[string]any, error) {
+	entries, err := plugin.AuthEntries()
+	if err != nil {
+		return nil, errors.New("Could not read saved accounts. Import stopped.")
+	}
+	auths := make(map[string]map[string]any, len(entries))
+	for key, raw := range entries {
+		var auth map[string]any
+		if json.Unmarshal(raw, &auth) != nil || auth == nil {
+			return nil, errors.New("Saved account data is invalid. Import stopped.")
+		}
+		auths[key] = auth
+	}
+	return auths, nil
+}
+
+func importDuplicate(a importedAccount, all map[string]map[string]any) bool {
+	for key, v := range all {
+		if plugin.ProviderOf(key) != a.site {
+			continue
+		}
+		if v["uid"] == a.uid {
+			return true
+		}
+	}
+	// Keep any existing seat for the UID: never overwrite it with exported
+	// credentials, even when an export omitted the original enterprise ID.
+	return false
+}
+func importLoginProblem(a importedAccount, now int64) string {
+	expires, _ := a.auth["expires"].(int64)
+	if expires <= 1 {
+		return "No expiration time. Sign in again from Providers."
+	}
+	if expires <= now {
+		return "Authorization expired. Sign in again from Providers."
+	}
+	return ""
+}
+
+func previewImports(rows []importFileRow, all map[string]map[string]any, renew bool) ([]importPreview, []importedAccount) {
+	previews := make([]importPreview, len(rows))
+	normalized := make([]importedAccount, len(rows))
+	seen := map[string]bool{}
+	now := time.Now().UnixMilli()
+	for i, row := range rows {
+		p := importPreview{Index: i, Name: "Account {n}", Status: "invalid"}
+		a, err := normalizeImport(row)
+		if err == nil && renew {
+			a, err = renewalImport(row, a)
+		}
+		if err != nil {
+			p.Detail = err.Error()
+		} else {
+			normalized[i] = a
+			p.Name = a.name
+			p.Site = map[string]string{"workbuddy": "WorkBuddy (China)", "workbuddy-ai": "WorkBuddy AI (International)"}[a.site]
+			id := a.site + "|" + a.uid
+			if seen[id] || (!renew && importDuplicate(a, all)) {
+				p.Status = "duplicate"
+				p.Detail = "Duplicate account. The existing sign-in will be kept."
+			} else if problem := importLoginProblem(a, now); !renew && problem != "" {
+				p.Status = "reauth"
+				p.Detail = problem
+			} else {
+				p.Status = "ready"
+				p.Detail = "Ready to import. Sign in again when authorization expires."
+				if renew {
+					p.Detail = "Ready to transfer this sign-in and enable automatic renewal."
+				}
+				seen[id] = true
+			}
+		}
+		previews[i] = p
+	}
+	return previews, normalized
+}
+
+var adoptImport = provider.Adopt
+var listImport = plugin.Providers
+var saveImport = plugin.ImportNewUID
+var renewImport = func(ctx context.Context, site string, texts []string) ([]provider.ImportedAccount, error) {
+	return provider.ImportPluginFiles(ctx, provider.PluginID(site), texts)
+}
+var readImport = existingImports
+var discoveryOffImport = settings.AccountDiscoveryOff
+
+func importAccounts(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	fail := func(message string) {
+		w.WriteHeader(400)
+		json.NewEncoder(w).Encode(map[string]string{"error": message})
+	}
+	var in struct {
+		Data   string `json:"data"`
+		Commit bool   `json:"commit"`
+		Renew  bool   `json:"renew"`
+	}
+	if json.NewDecoder(http.MaxBytesReader(w, r.Body, 7<<20)).Decode(&in) != nil {
+		fail("Could not read the import request.")
+		return
+	}
+	rows, err := parseImport(in.Data)
+	if err != nil {
+		fail(err.Error())
+		return
+	}
+	all, err := readImport()
+	if err != nil {
+		fail(err.Error())
+		return
+	}
+	previews, accounts := previewImports(rows, all, in.Renew)
+	if in.Commit {
+		if discoveryOffImport() {
+			fail("Enable subscription accounts in Magpie privacy settings first.")
+			return
+		}
+		ctx, cancel := context.WithTimeout(r.Context(), 4*time.Minute)
+		defer cancel()
+		prepareErrors := map[string]string{}
+		for i, a := range accounts {
+			if previews[i].Status != "ready" {
+				continue
+			}
+			message, prepared := prepareErrors[a.site]
+			if !prepared {
+				message = prepareWorkBuddyImport(ctx, a.site)
+				prepareErrors[a.site] = message
+			}
+			if message != "" {
+				previews[i].Status = "failed"
+				previews[i].Detail = message
+				continue
+			}
+			if in.Renew {
+				// The plugin validates and rotates the credential before saving
+				// it through the same path as a browser sign-in.
+				data, err := json.Marshal(a.auth)
+				if err != nil {
+					previews[i].Status = "failed"
+					previews[i].Detail = "Could not prepare the account for automatic renewal."
+					continue
+				}
+				results, err := renewImport(ctx, a.site, []string{string(data)})
+				if err != nil || len(results) != 1 || (results[0].Status != "added" && results[0].Status != "updated") {
+					previews[i].Status = "failed"
+					previews[i].Detail = "WorkBuddy could not renew this sign-in. Sign in on this computer again."
+					continue
+				}
+				previews[i].Status = "imported"
+				previews[i].Detail = "Imported with automatic renewal. The account stays saved; WorkBuddy may require sign-in again if it revokes the authorization."
+				continue
+			}
+			if problem := importLoginProblem(a, time.Now().UnixMilli()); problem != "" {
+				previews[i].Status = "reauth"
+				previews[i].Detail = problem
+				continue
+			}
+			saved, err := saveImport(ctx, a.site, a.auth)
+			if err != nil {
+				previews[i].Status = "failed"
+				previews[i].Detail = "Could not save the account. Check the plugin and try again."
+				continue
+			}
+			if !saved {
+				previews[i].Status = "duplicate"
+				previews[i].Detail = "Duplicate account. The existing sign-in was kept."
+				continue
+			}
+			previews[i].Status = "imported"
+			previews[i].Detail = "Imported. Sign in again from Providers when authorization expires."
+		}
+	}
+	json.NewEncoder(w).Encode(map[string]any{"accounts": previews, "committed": in.Commit})
+}
+
+func prepareWorkBuddyImport(ctx context.Context, site string) string {
+	if err := adoptImport(ctx, site); err != nil {
+		return "Could not prepare the WorkBuddy plugin. Check the network and plugin and try again."
+	}
+	pps, err := listImport(ctx)
+	if err == nil {
+		for _, p := range pps {
+			if p.ID == site && plugin.PackageName(p.Spec) == wbPackage {
+				return ""
+			}
+		}
+	}
+	return "The WorkBuddy community plugin is unavailable."
+}
