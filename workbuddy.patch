diff --git a/internal/update/workbuddy.go b/internal/update/workbuddy.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c232694c0b7fcc123056f862c83c962df872200
--- /dev/null
+++ b/internal/update/workbuddy.go
@@ -0,0 +1,92 @@
+package update
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/yetone/magpie/internal/lazyre"
+	"github.com/yetone/magpie/internal/source"
+)
+
+// workBuddyReleaseRepo is set in the Windows distribution by the release build.
+var workBuddyReleaseRepo string
+
+var workBuddyVersion = lazyre.New(`^v[0-9]+\.[0-9]+\.[0-9]+-workbuddy\.[1-9][0-9]*$`)
+var workBuddyRepository = lazyre.New(`^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$`)
+
+func WorkBuddyReleaseChannel() bool {
+	return goos == "windows" && workBuddyRepository.MatchString(workBuddyReleaseRepo)
+}
+
+func workBuddyReleasePage(tag string) string {
+	return githubWeb + "/" + workBuddyReleaseRepo + "/releases/tag/" + tag
+}
+
+func workBuddyLatest(ctx context.Context, lang string) (*Release, error) {
+	repoAPI := githubAPI + "/repos/" + workBuddyReleaseRepo
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, repoAPI+"/releases/latest", nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("X-GitHub-Api-Version", "2022-11-28")
+	// GitHub's authenticated HTTPS response supplies the asset checksum.
+	// Mirrors can serve bytes, but never choose what checksum is trusted.
+	strict := *client
+	strict.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	res, err := source.DoOfficial(&strict, req)
+	if err != nil {
+		return nil, err
+	}
+	defer res.Body.Close()
+	if res.StatusCode == http.StatusNotFound {
+		return nil, errors.New("no Magpie Windows update has been published yet")
+	}
+	if res.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("Magpie Windows update channel: %s", res.Status)
+	}
+	var gh struct {
+		Tag        string `json:"tag_name"`
+		Body       string `json:"body"`
+		Draft      bool   `json:"draft"`
+		Prerelease bool   `json:"prerelease"`
+		Assets     []struct {
+			ID     int64  `json:"id"`
+			Name   string `json:"name"`
+			Size   int64  `json:"size"`
+			State  string `json:"state"`
+			Digest string `json:"digest"`
+		} `json:"assets"`
+	}
+	if err := json.NewDecoder(io.LimitReader(res.Body, 2<<20)).Decode(&gh); err != nil {
+		return nil, fmt.Errorf("Magpie Windows update metadata: %w", err)
+	}
+	if gh.Draft || gh.Prerelease || !workBuddyVersion.MatchString(gh.Tag) || parse(gh.Tag) == nil {
+		return nil, errors.New("invalid Magpie Windows release")
+	}
+	name := "magpie-windows-" + arch() + ".exe"
+	for _, a := range gh.Assets {
+		if a.Name != name || a.State != "uploaded" || a.ID < 1 || a.Size < 1 {
+			continue
+		}
+		hash, ok := strings.CutPrefix(a.Digest, "sha256:")
+		checksum, err := hex.DecodeString(hash)
+		if !ok || err != nil || len(checksum) != sha256.Size {
+			return nil, errors.New("Magpie Windows update is missing a valid SHA-256 checksum")
+		}
+		u := githubWeb + "/" + workBuddyReleaseRepo + "/releases/download/" + gh.Tag + "/" + name
+		asset := Asset{URL: u, GitHub: u, API: fmt.Sprintf("%s/releases/assets/%d", repoAPI, a.ID), Size: a.Size, SHA256: hash}
+		return &Release{
+			Version: strings.TrimPrefix(gh.Tag, "v"), Notes: InLang(gh.Body, lang),
+			URL: workBuddyReleasePage(gh.Tag), Assets: map[string]Asset{name: asset},
+		}, nil
+	}
+	return nil, fmt.Errorf("Magpie Windows update has no %s", name)
+}
