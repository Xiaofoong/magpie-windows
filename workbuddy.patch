+func TestWorkBuddyImportRenewsOnlyAfterConfirmation(t *testing.T) {
+	all := importHarness(t)
+	original := renewImport
+	t.Cleanup(func() { renewImport = original })
+	calls := 0
+	renewImport = func(_ context.Context, site string, texts []string) ([]provider.ImportedAccount, error) {
+		calls++
+		if site != "workbuddy" || len(texts) != 1 {
+			t.Fatal("unexpected renewable import")
+		}
+		var auth map[string]any
+		if err := json.Unmarshal([]byte(texts[0]), &auth); err != nil {
+			t.Fatal(err)
+		}
+		if auth["refresh"] != "fixture-refresh-cn" || auth["uid"] != "cn-user" {
+			t.Fatal("renewal credential or account identity missing")
+		}
+		auth["access"], auth["refresh"] = "renewed-access-fixture", "renewed-refresh-fixture"
+		all["workbuddy#cn-user"] = auth
+		return []provider.ImportedAccount{{Status: "updated", User: "cn-user"}}, nil
+	}
+	// An existing access-only login can be upgraded. Its expired access
+	// token does not prevent WorkBuddy from validating its refresh token.
+	all["workbuddy#cn-user"] = map[string]any{"uid": "cn-user", "access": "previous-access-fixture"}
+	expired := strings.Replace(cnFixture, `"expiresAt":1800000000`, `"expiresAt":1700000000`, 1)
+	preview := callRenewableImport(t, expired, false)
+	if calls != 0 || !strings.Contains(preview, `"status":"ready"`) || strings.Contains(preview, "fixture-refresh") {
+		t.Fatal("preview renewed, leaked or rejected the renewable account")
+	}
+	result := callRenewableImport(t, expired, true)
+	if calls != 1 || !strings.Contains(result, `"status":"imported"`) || strings.Contains(result, "fixture") {
+		t.Fatal("confirmation did not complete renewable import safely")
+	}
+	if all["workbuddy#cn-user"]["refresh"] != "renewed-refresh-fixture" {
+		t.Fatal("renewed sign-in not retained")
+	}
+}
+
+func TestWorkBuddyImportRenewalRequiresUsableRefresh(t *testing.T) {
+	all := importHarness(t)
+	original := renewImport
+	t.Cleanup(func() { renewImport = original })
+	calls := 0
+	renewImport = func(context.Context, string, []string) ([]provider.ImportedAccount, error) {
+		calls++
+		return nil, errors.New("refresh-fixture-secret")
+	}
+	missing := strings.Replace(cnFixture, `"refreshToken":"fixture-refresh-cn",`, "", 1)
+	expired := strings.Replace(cnFixture, `"refreshToken":"fixture-refresh-cn"`, `"refreshToken":"fixture-refresh-cn","refreshExpiresAt":1700000000`, 1)
+	for _, data := range []string{missing, expired} {
+		result := callRenewableImport(t, currentFixture(data), true)
+		if calls != 0 || len(all) != 0 || !strings.Contains(result, `"status":"invalid"`) {
+			t.Fatal("an unusable refresh credential reached renewal")
+		}
+	}
+	result := callRenewableImport(t, currentFixture(cnFixture), true)
+	if calls != 1 || len(all) != 0 || !strings.Contains(result, `"status":"failed"`) || strings.Contains(result, "refresh-fixture-secret") {
+		t.Fatal("renewal failure leaked a credential or reported success")
+	}
+}
+func currentFixture(data string) string {
+	return strings.ReplaceAll(data, "1800000000", strconv.FormatInt(time.Now().Add(time.Hour).Unix(), 10))
+}
+
+func callImport(t *testing.T, data string, commit bool) string {
+	t.Helper()
+	body, _ := json.Marshal(map[string]any{"data": data, "commit": commit})
+	w := httptest.NewRecorder()
+	Handler(nil, nil).ServeHTTP(w, httptest.NewRequest("POST", "/api/workbuddy/import", strings.NewReader(string(body))))
