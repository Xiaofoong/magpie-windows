+func importHarness(t *testing.T) map[string]map[string]any {
+	t.Helper()
+	oa, ol, os, or, od := adoptImport, listImport, saveImport, readImport, discoveryOffImport
+	t.Cleanup(func() { adoptImport, listImport, saveImport, readImport, discoveryOffImport = oa, ol, os, or, od })
+	all := map[string]map[string]any{}
+	readImport = func() (map[string]map[string]any, error) { return all, nil }
+	discoveryOffImport = func() bool { return false }
+	adoptImport = func(context.Context, string) error { return nil }
+	listImport = func(context.Context) ([]plugin.Provider, error) {
+		return []plugin.Provider{{ID: "workbuddy", Spec: wbPackage}, {ID: "workbuddy-ai", Spec: wbPackage}}, nil
+	}
+	saveImport = func(_ context.Context, id string, a map[string]any) (bool, error) {
+		key := id + "#" + a["uid"].(string)
+		if all[key] != nil {
+			return false, nil
+		}
+		all[key] = a
