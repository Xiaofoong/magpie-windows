+// ImportNewUID saves a WorkBuddy export without replacing an existing sign-in.
+// The host checks the UID and writes under the same lock.
+func ImportNewUID(ctx context.Context, provider string, auth map[string]any) (bool, error) {
+	var r struct {
+		Account string `json:"account"`
+	}
+	err := Call(ctx, "import", map[string]any{"provider": provider, "auth": auth, "keepUID": true}, &r)
+	return r.Account != "", err
+}
