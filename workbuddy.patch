+const flatFixture = `{"id":"fixture-id","label":"Fixture label","uid":"flat-cn","nickname":"Fixture flat","accessToken":"fixture-flat-access","refreshToken":"fixture-flat-refresh","expiresAt":1800000000000,"refreshExpiresAt":1801000000000,"domain":"copilot.tencent.com","edition":"cn","type":"personal","enterpriseId":""}`
+
+func TestFlatAndDomesticFormats(t *testing.T) {
+	for _, input := range []string{flatFixture, "[" + flatFixture + "]", `{"accounts":[` + flatFixture + `]}`} {
+		rows, e := parseImport(input)
+		if e != nil || len(rows) != 1 {
+			t.Fatal("flat decode", e)
+		}
+		a, e := normalizeImport(rows[0])
+		if e != nil || a.site != "workbuddy" || a.uid != "flat-cn" || a.auth["expires"] != int64(1800000000000) || a.auth["refreshExpiresAt"] != nil {
+			t.Fatal("flat normalization", e)
+		}
+	}
+	input := strings.ReplaceAll(strings.ReplaceAll(flatFixture, `"edition":"cn"`, `"edition":"intl"`), "copilot.tencent.com", "www.workbuddy.ai")
+	rows, e := parseImport(input)
+	if e != nil {
+		t.Fatal(e)
+	}
+	a, e := normalizeImport(rows[0])
+	if e != nil || a.site != "workbuddy-ai" {
+		t.Fatal("flat international", e)
+	}
+	domestic := strings.ReplaceAll(strings.ReplaceAll(aiFixture, "international", "domestic"), "www.workbuddy.ai", "copilot.tencent.com")
+	rows, e = parseImport(domestic)
+	if e != nil {
+		t.Fatal(e)
+	}
+	a, e = normalizeImport(rows[0])
+	if e != nil || a.site != "workbuddy" {
+		t.Fatal("domestic region", e)
+	}
+	bad := strings.Replace(flatFixture, `"edition":"cn"`, `"edition":"cn","region":"international"`, 1)
+	rows, _ = parseImport(bad)
+	if _, e = normalizeImport(rows[0]); e == nil {
+		t.Fatal("conflicting edition accepted")
+	}
+}
