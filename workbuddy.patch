@@ -0,0 +1,75 @@
+package update
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestWorkBuddyExecutableStaysAtItsOwnPath(t *testing.T) {
+	fixture := newInstallFixture(t)
+	fixture.installed(t, "standard install", 7)
+	oldRepo, oldOS := workBuddyReleaseRepo, goos
+	workBuddyReleaseRepo, goos = "fixture/magpie-windows", "windows"
+	t.Cleanup(func() { workBuddyReleaseRepo, goos = oldRepo, oldOS })
+	if to, err := settle(fixture.exe); to != "" || err != nil || forwards(fixture.exe) {
+		t.Fatalf("the WorkBuddy executable did not stay in Downloads: %q, %v", to, err)
+	}
+}
+
+func TestWorkBuddyUpdateUsesOnlyItsReleaseChannel(t *testing.T) {
+	const repo, name = "fixture/magpie-windows", "magpie-windows-amd64.exe"
+	body := []byte("fixture desktop executable")
+	digest := fmt.Sprintf("sha256:%x", sha256.Sum256(body))
+	tag := "v0.1.3908-workbuddy.3"
+	releaseDigest := digest
+	downloadBody := body
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/repos/" + repo + "/releases/latest":
+			fmt.Fprintf(w, `{"tag_name":%q,"assets":[{"name":%q,"id":13,"size":%d,"state":"uploaded","digest":%q}]}`, tag, name, len(body), releaseDigest)
+		case "/" + repo + "/releases/download/" + tag + "/" + name:
+			w.Write(downloadBody)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer srv.Close()
+	oldRepo, oldWeb, oldAPI, oldOS, oldArch := workBuddyReleaseRepo, githubWeb, githubAPI, goos, goarch
+	workBuddyReleaseRepo, githubWeb, githubAPI, goos, goarch = repo, srv.URL, srv.URL, "windows", "amd64"
+	t.Cleanup(func() {
+		workBuddyReleaseRepo, githubWeb, githubAPI, goos, goarch = oldRepo, oldWeb, oldAPI, oldOS, oldArch
+	})
+	t.Setenv("MAGPIE_UPDATE_FEED", "http://127.0.0.1:1/official-feed")
+	quickRetries(t)
+	ctx := context.Background()
+	rel, err := Latest(ctx)
+	if err != nil || !Newer(rel.Version, "0.1.3908-workbuddy.2") {
+		t.Fatal("did not get a newer custom release", err)
+	}
+	file := filepath.Join(t.TempDir(), name)
+	if err := download(ctx, rel.Assets[name], file); err != nil {
+		t.Fatal(err)
+	}
+	if data, _ := os.ReadFile(file); string(data) != string(body) {
+		t.Fatal("download was not the selected executable")
+	}
+	downloadBody = []byte(strings.Repeat("x", len(body)))
+	if err := download(ctx, rel.Assets[name], filepath.Join(t.TempDir(), name)); err == nil {
+		t.Fatal("bad download passed the release checksum")
+	}
+	releaseDigest = ""
+	if _, err := Latest(ctx); err == nil {
+		t.Fatal("a release without a checksum was accepted")
+	}
+	releaseDigest, tag = digest, "v0.1.3909"
+	if _, err := Latest(ctx); err == nil {
+		t.Fatal("an official build could replace the custom build")
+	}
+}
