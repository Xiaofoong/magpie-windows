+func TestImportFormatsAndTimeUnits(t *testing.T) {
+	for _, data := range []string{"[" + cnFixture + "]", cnFixture, `{"accounts":[` + cnFixture + `]}`} {
+		rows, e := parseImport(data)
+		if e != nil || len(rows) != 1 {
+			t.Fatal("batch format", e)
+		}
+		a, e := normalizeImport(rows[0])
+		if e != nil || a.site != "workbuddy" || a.auth["expires"] != int64(1800000000000) {
+			t.Fatal("CN mapping/time", e)
